#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            // | Q | W | E |
            // | R | T | Y |
            bindings = <
                &kp Q  &kp W  &kp E
                &kp R  &kp T  &kp Y
            >;
        };
    };
};
