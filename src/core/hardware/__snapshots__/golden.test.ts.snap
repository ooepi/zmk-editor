// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Pro Micro shields (golden) > generates the same one-piece direct-wired pad with a nice!view 1`] = `
{
  "config/boards/shields/test_pad/Kconfig.defconfig": "# Generated by ZMK Editor from test_pad.editor.json.

if SHIELD_TEST_PAD

config ZMK_KEYBOARD_NAME
    default "Test Pad"

choice EC11_TRIGGER_MODE
    default EC11_TRIGGER_GLOBAL_THREAD
endchoice

endif
",
  "config/boards/shields/test_pad/Kconfig.shield": "# Generated by ZMK Editor from test_pad.editor.json.

config SHIELD_TEST_PAD
    def_bool $(shields_list_contains,test_pad)
",
  "config/boards/shields/test_pad/test_pad.editor.json": "{
  "version": 1,
  "name": "test_pad",
  "displayName": "Test Pad",
  "controller": "nice_nano_v2",
  "split": false,
  "wiring": {
    "kind": "direct",
    "pins": [
      4,
      5
    ]
  },
  "encoders": [
    {
      "a": 8,
      "b": 9
    }
  ],
  "displays": {
    "left": "nice_view"
  },
  "keys": [
    {"x":0,"y":0,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":0,"col":0},
    {"x":100,"y":0,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":0,"col":1}
  ]
}
",
  "config/boards/shields/test_pad/test_pad.overlay": "/* Generated by ZMK Editor from test_pad.editor.json. */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &test_pad_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&pro_micro  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <2>;
        map = <
RC(0,0) RC(0,1)
        >;
    };

    encoder_0: encoder_0 {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_0>;
        triggers-per-rotation = <20>;
    };

    test_pad_layout: test_pad_layout {
        compatible = "zmk,physical-layout";
        display-name = "Test Pad";
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot   rx   ry
            = <&key_physical_attrs 100 100    0    0      0    0    0>
            , <&key_physical_attrs 100 100  100    0      0    0    0>
            ;
    };
};
",
  "config/boards/shields/test_pad/test_pad.zmk.yml": "# Generated by ZMK Editor from test_pad.editor.json.
file_format: "1"
id: test_pad
name: Test Pad
type: shield
requires: [pro_micro]
features:
  - keys
",
}
`;

exports[`Pro Micro shields (golden) > generates the same split with encoders and OLEDs 1`] = `
{
  "config/boards/shields/golden_split/Kconfig.defconfig": "# Generated by ZMK Editor from golden_split.editor.json.

if SHIELD_GOLDEN_SPLIT_LEFT

config ZMK_KEYBOARD_NAME
    default "Golden Split"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_GOLDEN_SPLIT_LEFT || SHIELD_GOLDEN_SPLIT_RIGHT

config ZMK_SPLIT
    default y

choice EC11_TRIGGER_MODE
    default EC11_TRIGGER_GLOBAL_THREAD
endchoice

endif

if SHIELD_GOLDEN_SPLIT_LEFT || SHIELD_GOLDEN_SPLIT_RIGHT

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif
",
  "config/boards/shields/golden_split/Kconfig.shield": "# Generated by ZMK Editor from golden_split.editor.json.

config SHIELD_GOLDEN_SPLIT_LEFT
    def_bool $(shields_list_contains,golden_split_left)

config SHIELD_GOLDEN_SPLIT_RIGHT
    def_bool $(shields_list_contains,golden_split_right)
",
  "config/boards/shields/golden_split/golden_split.dtsi": "/* Generated by ZMK Editor from golden_split.editor.json. */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &golden_split_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <2>;
        columns = <6>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
        >;
    };

    left_encoder_0: encoder_left_0 {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    right_encoder_0: encoder_right_0 {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder_0 &right_encoder_0>;
        triggers-per-rotation = <20>;
    };

    golden_split_layout: golden_split_layout {
        compatible = "zmk,physical-layout";
        display-name = "Golden Split";
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot   rx   ry
            = <&key_physical_attrs 100 100    0    0      0    0    0>
            , <&key_physical_attrs 100 100  100    0      0    0    0>
            , <&key_physical_attrs 100 100  200    0      0    0    0>
            , <&key_physical_attrs 100 100  700    0      0    0    0>
            , <&key_physical_attrs 100 100  800    0      0    0    0>
            , <&key_physical_attrs 100 100  900    0      0    0    0>
            , <&key_physical_attrs 100 100    0  100      0    0    0>
            , <&key_physical_attrs 100 100  100  100      0    0    0>
            , <&key_physical_attrs 100 100  200  100      0    0    0>
            , <&key_physical_attrs 100 100  700  100      0    0    0>
            , <&key_physical_attrs 100 100  800  100      0    0    0>
            , <&key_physical_attrs 100 100  900  100      0    0    0>
            ;
    };
};
",
  "config/boards/shields/golden_split/golden_split.editor.json": "{
  "version": 1,
  "name": "golden_split",
  "displayName": "Golden Split",
  "controller": "nice_nano_v2",
  "split": true,
  "wiring": {
    "kind": "matrix",
    "diodeDirection": "row2col",
    "rows": [
      4,
      5
    ],
    "cols": [
      6,
      7,
      8
    ],
    "right": {
      "rows": [
        9,
        10
      ],
      "cols": [
        14,
        15,
        16
      ]
    }
  },
  "encoders": [
    {
      "a": 18,
      "b": 19
    }
  ],
  "rightEncoders": [
    {
      "a": 20,
      "b": 21
    }
  ],
  "displays": {
    "left": "oled_128x32",
    "right": "oled_128x64"
  },
  "keys": [
    {"x":0,"y":0,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":0,"col":0,"side":"left"},
    {"x":100,"y":0,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":0,"col":1,"side":"left"},
    {"x":200,"y":0,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":0,"col":2,"side":"left"},
    {"x":700,"y":0,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":0,"col":0,"side":"right"},
    {"x":800,"y":0,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":0,"col":1,"side":"right"},
    {"x":900,"y":0,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":0,"col":2,"side":"right"},
    {"x":0,"y":100,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":1,"col":0,"side":"left"},
    {"x":100,"y":100,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":1,"col":1,"side":"left"},
    {"x":200,"y":100,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":1,"col":2,"side":"left"},
    {"x":700,"y":100,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":1,"col":0,"side":"right"},
    {"x":800,"y":100,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":1,"col":1,"side":"right"},
    {"x":900,"y":100,"w":100,"h":100,"r":0,"rx":0,"ry":0,"row":1,"col":2,"side":"right"}
  ]
}
",
  "config/boards/shields/golden_split/golden_split.zmk.yml": "# Generated by ZMK Editor from golden_split.editor.json.
file_format: "1"
id: golden_split
name: Golden Split
type: shield
requires: [pro_micro]
features:
  - keys
siblings:
  - golden_split_left
  - golden_split_right
",
  "config/boards/shields/golden_split/golden_split_left.conf": "# Generated by ZMK Editor from golden_split.editor.json.
CONFIG_ZMK_DISPLAY=y
",
  "config/boards/shields/golden_split/golden_split_left.overlay": "/* Generated by ZMK Editor from golden_split.editor.json. */

#include "golden_split.dtsi"

&left_encoder_0 {
    status = "okay";
};

&kscan0 {
    row-gpios
        = <&pro_micro  4 GPIO_ACTIVE_HIGH>
        , <&pro_micro  5 GPIO_ACTIVE_HIGH>
        ;

    col-gpios
        = <&pro_micro  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro  7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
};

&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};

/ {
    chosen {
        zephyr,display = &oled;
    };
};
",
  "config/boards/shields/golden_split/golden_split_right.conf": "# Generated by ZMK Editor from golden_split.editor.json.
CONFIG_ZMK_DISPLAY=y
",
  "config/boards/shields/golden_split/golden_split_right.overlay": "/* Generated by ZMK Editor from golden_split.editor.json. */

#include "golden_split.dtsi"

&default_transform {
    col-offset = <3>;
};

&right_encoder_0 {
    status = "okay";
};

&kscan0 {
    row-gpios
        = <&pro_micro  9 GPIO_ACTIVE_HIGH>
        , <&pro_micro 10 GPIO_ACTIVE_HIGH>
        ;

    col-gpios
        = <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
};

&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep = <0x22>;
        inversion-on;
    };
};

/ {
    chosen {
        zephyr,display = &oled;
    };
};
",
}
`;
